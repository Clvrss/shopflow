# Copy this file to backend/.env and adjust as needed.

# Server
NODE_ENV=development
PORT=4000
API_BASE=/api/v1

# JWT
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# Database (SQLite by default)
DB_DIALECT=sqlite
# DB_STORAGE=./data/shopflow.sqlite

# Database (PostgreSQL example — also set POSTGRES_* in docker-compose.yml)
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=shopflow
# DB_USER=shopflow
# DB_PASSWORD=shopflow

# CORS — comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173
WEB_BASE_URL=http://localhost:5173

# Cache
CACHE_TTL_MS=60000

# Mail (preview=true prints emails to the backend log instead of sending)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@shopflow.test
MAIL_PREVIEW=true
